<mxfile host="app.diagrams.net">
  <diagram id="open-flow" name="开档流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="OpenCADStudio 开档流程（当前 → 目标）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="640" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="lane_ui" value="UI 线程" style="swimlane;horizontal=0;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1120" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="u1" value="用户选择文件&#xa;OpenPathPicked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="lane_ui">
          <mxGeometry x="40" y="60" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="显示 OpenProgress&#xa;overlay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="lane_ui">
          <mxGeometry x="220" y="60" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="u3" value="Task::perform&#xa;open_path_with_phase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="lane_ui">
          <mxGeometry x="400" y="60" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="u4" value="FileOpened&#xa;应用 doc + caches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="lane_ui">
          <mxGeometry x="780" y="60" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="u5" value="resolve_xrefs&#xa;⚠ 当前在 UI 线程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="lane_ui">
          <mxGeometry x="960" y="50" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="u6" value="bump_geometry&#xa;首帧 tess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="lane_ui">
          <mxGeometry x="960" y="140" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="lane_bg" value="后台 loader 线程" style="swimlane;horizontal=0;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1120" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="load_file&#xa;(DWG/DXF parse)&#xa;span: parse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="lane_bg">
          <mxGeometry x="40" y="70" width="130" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="purge_corrupt&#xa;span: purge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="lane_bg">
          <mxGeometry x="210" y="70" width="130" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="build_derived_caches&#xa;span: caches&#xa;⚠ 当前在 xref 前" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="lane_bg">
          <mxGeometry x="380" y="60" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="返回 (doc, caches)&#xa;+ OpenTimings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="lane_bg">
          <mxGeometry x="590" y="70" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b5" value="resolve_xrefs + inline purge&#xa;span: xref&#xa;✅ 目标移入后台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;dashed=1" vertex="1" parent="lane_bg">
          <mxGeometry x="380" y="160" width="190" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b6" value="build_derived_caches&#xa;✅ 目标在 xref 后" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;dashed=1" vertex="1" parent="lane_bg">
          <mxGeometry x="610" y="160" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="命令行输出：&#xa;Opened &quot;foo.dwg&quot; — N entities&#xa;parse / purge / xref / caches / first frame" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#36393d;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="Phase 进度条：&#xa;Reading → Parsing → Caching → Finalizing&#xa;(+ 目标新增 XREF phase)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffcc;strokeColor=#36393d;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="note3" value="优化里程碑 perf-open-baseline：&#xa;Phase 1.1 去 UI 二次 purge&#xa;Phase 1.2 XREF 后台化 + caches 顺序修正" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="780" y="540" width="380" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#666666" edge="1" parent="1" source="u3" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;strokeColor=#666666" edge="1" parent="1" source="b4" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450" edge="1" parent="1" source="u4" target="u5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#b85450" edge="1" parent="1" source="u5" target="u6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="endArrow=classic;html=1;exitX=0.5;exitY=0;entryX=0.25;entryY=1;dashed=1;strokeColor=#82b366" edge="1" parent="1" source="b5" target="b2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="290"/><mxPoint x="275" y="290"/></Array></mxGeometry></mxCell>
        <mxCell id="e11" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#82b366" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#82b366" edge="1" parent="1" source="b6" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="实线 = 当前实现 | 虚线绿色 = 目标优化路径 | 红色 = 已知性能问题" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="280" y="650" width="640" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>